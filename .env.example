# Copy to .env.local for local development.
# Never commit real secrets, API keys, or mailbox passwords.

# App URL (auth redirects, links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only)
SUPABASE_SERVICE_ROLE_KEY=

# Resend — application transactional email (invoices, reminders, newsletter)
RESEND_API_KEY=

# Central transactional From identity (production required — deployment must not proceed without this)
ARREXIA_EMAIL_FROM=Arrexia <hello@arrexia.app>
# Backward-compatible alias; ARREXIA_EMAIL_FROM takes precedence when both are set
EMAIL_FROM=onboarding@resend.dev

# Category Reply-To routing (optional; defaults to @arrexia.app addresses in code)
ARREXIA_EMAIL_REPLY_TO_SUPPORT=support@arrexia.app
ARREXIA_EMAIL_REPLY_TO_BILLING=billing@arrexia.app
ARREXIA_EMAIL_REPLY_TO_COLLECTIONS=collections@arrexia.app
ARREXIA_EMAIL_REPLY_TO_SALES=sales@arrexia.app
ARREXIA_EMAIL_REPLY_TO_GENERAL=hello@arrexia.app

# Internal notification recipients for future/server-side forms (optional)
ARREXIA_EMAIL_TO_SUPPORT=support@arrexia.app
ARREXIA_EMAIL_TO_BILLING=billing@arrexia.app
ARREXIA_EMAIL_TO_COLLECTIONS=collections@arrexia.app
ARREXIA_EMAIL_TO_SALES=sales@arrexia.app
ARREXIA_EMAIL_TO_GENERAL=hello@arrexia.app

# Cron / scheduled jobs
CRON_SECRET=

# Optional feature flags
NEXT_PUBLIC_ENABLE_SOCIAL_AUTH=true

# Supabase Auth email is configured in the Supabase Dashboard (SMTP), not here.
# See docs/authentication-email-branding.md and docs/email-operations.md.
